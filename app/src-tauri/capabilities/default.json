{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "shell:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "pace",
          "cmd": "pace",
          "args": true
        },
        {
          "name": "ls",
          "cmd": "ls",
          "args": true
        },
        {
          "name": "pwd",
          "cmd": "pwd",
          "args": true
        },
        {
          "name": "dotnet",
          "cmd": "dotnet",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "python",
          "cmd": "python",
          "args": ["--version"]
        },
        {
          "name": "git",
          "cmd": "git",
          "args": true
        },
        {
          "name": "pip install pipx",
          "cmd": "python",
          "args": ["-m", "pip", "install", "pipx"]
        },
        {
          "name": "pipx",
          "cmd": "pipx",
          "args": true
        },
        {
          "name": "pace",
          "cmd": "pace",
          "args": true
        },
        {
          "name": "ls",
          "cmd": "ls",
          "args": true
        },
        {
          "name": "dotnet",
          "cmd": "dotnet",
          "args": true
        }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-resource-read-recursive",
    "fs:allow-resource-meta-recursive",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.pace"
        },
        {
          "path": "$HOME/.pace/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/.pace"
        },
        {
          "path": "$HOME/.pace/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-create",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-app-write-recursive",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/.pace"
        },
        {
          "path": "$HOME/.pace/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.pace"
        },
        {
          "path": "$HOME/.pace/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "/tmp/**"
        },
        {
          "path": "**/*.toml"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "*/**"
        },
        {
          "path": "$HOME/.pace/configs"
        },
        {
          "path": "$HOME/.pace/configs/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.pace/configs/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/.pace/**"
        },
        {
          "path": "$HOME/.nuget/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.pace"
        },
        {
          "path": "$HOME/.pace/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    "dialog:default"
  ]
}
