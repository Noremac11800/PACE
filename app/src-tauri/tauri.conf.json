{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pace-dotnet",
  "version": "0.1.6",
  "identifier": "com.cam.pace-dotnet",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PACE",
        "width": 800,
        "height": 600,
        "minWidth": 680,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMjUyOURDQkYyNTQ3MjUKUldRbFJ5Vy8zQ2tsN2l4c2t4MlgrMGRaN0s4MmZDN2l6aGRRZXIveU1IMlZVWnRYSldJeUpHSWgK",
      "endpoints": [
        "https://github.com/Noremac11800/PACE/releases/latest/download/latest.json"
      ]
    }
  }
}
